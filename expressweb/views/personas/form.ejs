<%- include('../components/header') %>
    <div class="container">
        <div class="row">
            <div class="col">
                <div class="card mt-3">
                    <div class="card-body">
                        <h5 class="card-title">Formulario de Personas</h5>
                        <%- include('../components/errors') %>
                            <form method="post" action="">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <div class="mb-2">
                                    <label>Nombre</label>
                                    <input required class="form-control" type="text" name="nombre" placeholder="Nombre"
                                        value="<%= model?.nombre %>" />
                                </div>
                                <div class="mb-2">
                                    <label>Apellido</label>
                                    <input required class="form-control" type="text" name="apellido"
                                        placeholder="Apellido" value="<%= model?.apellido %>" />
                                </div>
                                <div class="mb-2">
                                    <label>Edad</label>
                                    <input required class="form-control" type="number" name="edad" placeholder="Edad"
                                        value="<%= model?.edad %>" />
                                </div>
                                <div class="mb-2">
                                    <label>Ciudad</label>
                                    <input required class="form-control" type="text" name="ciudad" placeholder="Ciudad"
                                        value="<%= model?.ciudad %>" />
                                </div>
                                <div class="mb-2">
                                    <label>Fecha de nacimiento</label>
                                    <input required class="form-control" type="date" name="fechaNacimiento"
                                        placeholder="Fecha de nacimiento"
                                        value="<%= model?.fechaNacimiento.toISOString().split('T')[0] %>" />
                                </div>
                                <button class="btn btn-primary" type="submit">Guardar</button>
                            </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <%- include('../components/footer') %>

<%- include('../components/header') %>
    <div class="container">
        <div class="row">
            <div class="col">
                <div class="card mt-3">
                    <div class="card-body">
                        <h5 class="card-title">Formulario de contacto</h5>
                        <form method="post" action="/formsubmit">
                            <div class="mb-2">
                                <label>Nombre</label>
                                <input class="form-control" type="text" name="nombre" placeholder="Nombre" />
                            </div>
                            <div class="mb-2">
                                <label>Apellido</label>
                                <input class="form-control" type="text" name="apellido" placeholder="Apellido" />
                            </div>
                            <h5>Segunda persona</h5>
                            <div class="mb-2">
                                <label>Nombre</label>
                                <input class="form-control" type="text" name="nombre2" placeholder="Nombre" />
                            </div>
                            <div class="mb-2">
                                <label>Apellido</label>
                                <input class="form-control" type="text" name="apellido2" placeholder="Apellido" />
                            </div>
                            <button class="btn btn-primary" type="submit">Enviar datos</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <%- include('../components/footer') %>
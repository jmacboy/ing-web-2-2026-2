<%- include('../components/header') %>

    <div class="container">
        <div class="row mt-3">
            <div class="col">
                <a class="btn btn-primary" href="/peliculas/create">Crear Pelicula</a>
            </div>
        </div>
        <div class="row mt-3">
            <div class="col">
                <form method="get" action="/peliculas">
                    <div class="row">
                        <div class="col">
                            <select class="form-select" name="genero">
                                <option value="">Todos los géneros</option>
                                <% generos.forEach(objGenero=> { %>
                                    <option value="<%= objGenero.id %>" <%=objGenero.id==genero ? 'selected' : '' %>>
                                        <%= objGenero.nombre %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="col">
                            <div class="input-group mb-3">
                                <input type="text" class="form-control" placeholder="Buscar por título" name="q"
                                    value="<%= search %>">
                                <button class="btn btn-outline-secondary" type="submit">Buscar</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <div class="row">
            <div class="col">
                <h1>Lista de peliculas</h1>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Titulo</th>
                            <th>Año</th>
                            <th>Rating</th>
                            <th>Género</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (peliculas.length==0) { %>
                            <tr>
                                <td class="text-center" colspan="6">No hay peliculas registradas.</td>
                            </tr>
                            <% } else { %>
                                <% peliculas.forEach(pelicula=> { %>
                                    <tr>
                                        <td>
                                            <%= pelicula.id %>
                                        </td>
                                        <td>
                                            <%= pelicula.titulo %>
                                        </td>
                                        <td>
                                            <%= pelicula.anio %>
                                        </td>
                                        <td>
                                            <%= pelicula.rating %>
                                        </td>
                                        <td>
                                            <%= pelicula.genero.id %>
                                                <%= pelicula.genero.nombre %>
                                        </td>

                                    </tr>
                                    <% }) %>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <%- include('../components/footer') %>